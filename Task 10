import java.util.Scanner;
public class Lab4Task10 {
	public static void main(String [] args){
		Scanner input = new Scanner(System.in);
		System.out.print("Enter the number of books purchased: ");
		int books= input.nextInt();
		
		switch(books){
		case 1:
		System.out.print("Points earned are 0");
		break;

		case 2:
		System.out.print("Points earned are 5");
		break;

		case 3:
		System.out.print("Points earned are 30");
		break;

		default:
		System.out.print("Points earned are 60");
		break;
		}
		}
	}
